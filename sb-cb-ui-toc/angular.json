{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "toc": {
      "projectType": "library",
      "root": "library/sunbird-cb/toc",
      "sourceRoot": "library/sunbird-cb/toc/src",
      "prefix": "sb-uic",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "library/sunbird-cb/toc/tsconfig.lib.json",
            "project": "library/sunbird-cb/toc/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "library/sunbird-cb/toc/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "library/sunbird-cb/toc/tsconfig.lib.dev.json"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "library/sunbird-cb/toc/src/test.ts",
            "tsConfig": "library/sunbird-cb/toc/tsconfig.spec.json",
            "karmaConfig": "library/sunbird-cb/toc/karma.conf.js"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  }
}
