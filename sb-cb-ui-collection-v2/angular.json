{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "project",
  "projects": {
    "@sunbird-cb/collectionV2": {
      "projectType": "library",
      "root": "library/sunbird-cb/collectionV2",
      "sourceRoot": "library/sunbird-cb/collectionV2/src",
      "prefix": "sunbird-cb",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "library/sunbird-cb/collectionV2/tsconfig.lib.json",
            "project": "library/sunbird-cb/collectionV2/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "library/sunbird-cb/collectionV2/tsconfig.lib.prod.json"
            }
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "library/sunbird-cb/collectionV2/src/test.ts",
            "tsConfig": "library/sunbird-cb/collectionV2/tsconfig.spec.json",
            "karmaConfig": "library/sunbird-cb/collectionV2/karma.conf.js"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "cli": {
    "analytics": "90ed193f-68b3-414f-8e2d-5810c7b9bba8"
  }
}
