{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "@sunbird-cb/search-listing": {
      "projectType": "library",
      "root": "projects/sunbird-cb/search-listing",
      "sourceRoot": "projects/sunbird-cb/search-listing/src",
      "prefix": "sb-cb-search",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/sunbird-cb/search-listing/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/sunbird-cb/search-listing/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/sunbird-cb/search-listing/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/sunbird-cb/search-listing/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  }
}
